{
  "name": "merlin",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": "24.22.1",
    "pnpm": "12.15.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:test-harness": "powershell -NoProfile -File scripts/build-test-harness.ps1",
    "verify:production-boundary": "powershell -NoProfile -File scripts/verify-production-boundary.ps1",
    "tauri": "powershell -NoProfile -File scripts/native.ps1 pnpm exec tauri",
    "setup:rust": "powershell -NoProfile -File scripts/setup-rust.ps1",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "format:check": "prettier --check . && powershell -NoProfile -File scripts/native.ps1 cargo fmt --manifest-path src-tauri/Cargo.toml -- --check",
    "lint:frontend": "eslint . --max-warnings=0",
    "lint:rust": "powershell -NoProfile -File scripts/native.ps1 cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "lint:rust:harness": "powershell -NoProfile -File scripts/native-harness.ps1 cargo clippy --manifest-path src-tauri/Cargo.toml --features test-harness --all-targets -- -D warnings",
    "lint": "pnpm lint:frontend && pnpm lint:rust && pnpm lint:rust:harness",
    "test:frontend": "vitest run",
    "test:rust": "powershell -NoProfile -File scripts/native.ps1 cargo test --manifest-path src-tauri/Cargo.toml",
    "test:rust:harness": "powershell -NoProfile -File scripts/native-harness.ps1 cargo test --manifest-path src-tauri/Cargo.toml --features test-harness",
    "test:e2e": "playwright test --config playwright.chromium.config.ts",
    "test:webview2": "playwright test --config playwright.webview2.config.ts",
    "test:contrast": "node scripts/validate-themes.mjs",
    "test": "pnpm test:frontend && pnpm test:rust && pnpm test:rust:harness && pnpm test:contrast"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@milkdown/kit": "7.23.0",
    "@tauri-apps/api": "2.12.5",
    "@ui-sdk/core": "0.1.0-beta.13",
    "@ui-sdk/react": "0.1.0-beta.13",
    "class-variance-authority": "0.7.1",
    "cn": "0.5.2",
    "hast-util-to-jsx-runtime": "2.3.7",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rehype-raw": "7.0.0",
    "rehype-sanitize": "6.0.0",
    "remark-frontmatter": "5.0.0",
    "remark-gfm": "4.0.1",
    "remark-parse": "11.0.0",
    "remark-rehype": "11.1.2",
    "unified": "11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.65.1",
    "@tailwindcss/vite": "4.3.5",
    "@tauri-apps/cli": "2.12.6",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "8.0.0",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "10.15.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "eslint-plugin-react-refresh": "0.5.8",
    "jsdom": "31.0.1",
    "playwright": "1.65.1",
    "prettier": "3.10.1",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
