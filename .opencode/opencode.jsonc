{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "merlin-orchestrator",
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "deny" },
    {
      "action": "external_directory",
      "resource": "C:/Users/Win8.1/AppData/Local/Temp/opencode/*",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "C:/Users/Win8.1/.rustup/toolchains/stable-x86_64-pc-windows-msvc/*",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "C:/Program Files/Microsoft Visual Studio/*",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "C:/Program Files (x86)/Microsoft Visual Studio/*",
      "effect": "allow",
    },
    {
      "action": "external_directory",
      "resource": "C:/Program Files (x86)/Windows Kits/*",
      "effect": "allow",
    },
    { "action": "external_directory", "resource": "C:/Program Files/nodejs/*", "effect": "allow" },
    { "action": "generate_image", "resource": "*", "effect": "deny" },
    { "action": "generate_video", "resource": "*", "effect": "deny" },
    { "action": "browser", "resource": "*", "effect": "deny" },
    { "action": "webfetch", "resource": "*", "effect": "deny" },
    { "action": "websearch", "resource": "*", "effect": "deny" },
  ],
  "policies": [
    { "action": "tool.use", "resource": "shell:git commit *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git push *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git reset --hard *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git clean *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git rebase *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git filter-branch *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git filter-repo *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git checkout -- *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git restore *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git stash drop *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git stash clear *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git branch -D *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git tag *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git reflog expire *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git gc --prune=now *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:git update-ref -d *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rm -rf *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rm -r *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:Remove-Item * -Recurse *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:Remove-Item -Recurse *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rd /s *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rmdir /s *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:del /s *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:pnpm publish *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:npm publish *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:cargo publish *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh release *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh workflow run *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:gh api *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:curl *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:wget *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:Invoke-WebRequest *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:Invoke-RestMethod *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:scp *", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rsync *", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.env", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.env.*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.env.example", "effect": "allow" },
    { "action": "tool.use", "resource": "read:*.key", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.pem", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.pfx", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*.p12", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*auth.json", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.config/opencode/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.ssh/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.arena/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.aws/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.config/gh/*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*/.cargo/credentials*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*id_rsa", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*id_rsa.*", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*id_ed25519", "effect": "deny" },
    { "action": "tool.use", "resource": "read:*id_ed25519.*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.env", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.env.*", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.env.example", "effect": "allow" },
    { "action": "tool.use", "resource": "edit:*.key", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*.pem", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:*auth.json", "effect": "deny" },
    { "action": "tool.use", "resource": "edit:.git/*", "effect": "deny" },
    { "action": "tool.use", "resource": "mcp.use:*", "effect": "deny" },
  ],
  "agents": {
    "explore": {
      "description": "Read-only repository discovery for Merlin checkpoints",
      "model": "tokenrouter/deepseek-v4.1-flash-1017-free",
      "permissions": [
        { "action": "*", "resource": "*", "effect": "deny" },
        { "action": "read", "resource": "*", "effect": "allow" },
        { "action": "glob", "resource": "*", "effect": "allow" },
        { "action": "grep", "resource": "*", "effect": "allow" },
        { "action": "external_directory", "resource": "*", "effect": "deny" },
      ],
    },
  },
}
